# ===== Этап 1: База растений =====
data = input("Растения (Название цвет размер рост, ...): ")
plants = data.split(', ')
print("\nРастения на ферме:")
for p in plants:
    print(f"  - {p}")

# ===== Этап 2: Проверка скрещивания =====
hybrids_input = input("\nГибриды (Роза+Тюльпан=Розотюль, ...): ")
hybrids = {}
for h in hybrids_input.split(', '):
    left, right = h.split('=')
    p1, p2 = sorted(left.split('+'))
    hybrids[(p1, p2)] = right

p1, p2 = sorted(input("Два растения через пробел: ").split())
if (p1, p2) in hybrids:
    print(f"Получен гибрид: {hybrids[(p1, p2)]}")
else:
    print("Эти растения нельзя скрестить.")
    exit()

# ===== Этап 3.1: Цвет гибрида =====
print("\n--- Характеристики родителей ---")
name1 = input("Название 1: ")
color1 = input("Цвет1 Размер1 Рост1: ").split()
size1, grow1 = color1[1], color1[2]
color1 = color1[0]

name2 = input("Название 2: ")
color2 = input("Цвет2 Размер2 Рост2: ").split()
size2, grow2 = color2[1], color2[2]
color2 = color2[0]

# Цвет
hybrid_color = color1 if name1 < name2 else color2
print(f"\nЦвет гибрида: {hybrid_color}")

# ===== Этап 3.2: Размер гибрида =====
sizes = ["малый", "средний", "крупный"]
if size1 == size2:
    hybrid_size = size1
else:
    # Сортируем по порядку в списке sizes
    idx1, idx2 = sizes.index(size1), sizes.index(size2)
    smaller = sizes[min(idx1, idx2)]
    larger = sizes[max(idx1, idx2)]
    hybrid_size = f"{smaller}/{larger}"

print(f"Размер гибрида: {hybrid_size}")

# ===== Этап 3.3: Скорость роста гибрида =====
growth_rates = ["медленный", "средний", "быстрый"]
# Наследуем наименьшую скорость (самый медленный)
idx1, idx2 = growth_rates.index(grow1), growth_rates.index(grow2)
hybrid_growth = growth_rates[min(idx1, idx2)]

print(f"Скорость роста гибрида: {hybrid_growth}")
